# =============================================================================
# Preprocessor image: base + OpenCV (headless)
# Used by: rgb-preprocessor, ir-preprocessor
# =============================================================================
ARG BASE_IMAGE=uav-edge-base:latest
FROM ${BASE_IMAGE}

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

COPY requirements/preprocessor.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

COPY src/app.py /app/app.py
