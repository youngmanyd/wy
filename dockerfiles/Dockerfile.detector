ARG BASE_IMAGE=uav-edge-base:latest
FROM ${BASE_IMAGE}

COPY requirements/detector.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

RUN pip install --no-cache-dir ultralytics && \
    python -c "from ultralytics import YOLO; m = YOLO('yolov8n.pt'); m.export(format='onnx', imgsz=640)" && \
    mkdir -p /app/models && mv yolov8n.onnx /app/models/ && \
    pip uninstall -y ultralytics torch torchvision torchaudio && \
    rm -rf /root/.cache /tmp/* yolov8n.pt

ARG SERVICE_NAME=rgb-detector
COPY services/common.py /app/common.py
COPY services/${SERVICE_NAME}/app.py /app/app.py

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
